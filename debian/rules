#!/usr/bin/make -f
export GO111MODULE := off

export DH_GOPKG := jsouthworth.net/go/try

GOBUILDDIR := _build

%:
	dh $@ --buildsystem=golang --with golang --builddirectory=$(GOBUILDDIR)

# NuDanOS: vet every Go package
override_dh_auto_build: vet
	dh_auto_build

vet:
	cd $(GOBUILDDIR)/src/$(DH_GOPKG) && GOPATH=$(CURDIR)/$(GOBUILDDIR) go vet ./...
